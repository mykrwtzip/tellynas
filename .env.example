# ── Telegram storage ─────────────────────────────────────────────────────────
# 1. Create a bot with @BotFather and copy the token.
# 2. Send /start to your bot, then read the chat id (e.g. via @userinfobot).
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_private_chat_id_here

# ── Access control ───────────────────────────────────────────────────────────
APP_USERNAME=admin
APP_PASSWORD=change-me-to-something-strong
# Random string used to sign session cookies (openssl rand -hex 32)
AUTH_SECRET=replace-with-a-long-random-string

# ── Optional ─────────────────────────────────────────────────────────────────
# Chunk size in MB sent per Telegram message (max 19, default 8).
TELEGRAM_CHUNK_MB=8
# Force the in-memory demo driver (no Telegram needed).
DEMO_MODE=false
# Upstash Redis REST for a persistent file index on serverless hosts.
# Without it, a JSON index is kept in .data/index.json (self-hosted).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
