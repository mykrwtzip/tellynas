# ── Telegram storage ─────────────────────────────────────────────────────────
# 1. Create bot(s) with @BotFather (https://t.me/BotFather) → /newbot → copy token(s).
#    Multiple tokens (comma-separated) round-robin chunks for higher throughput.
# 2. Create a private channel or group for storage, add EVERY bot as admin
#    with “Pin messages” + “Delete messages” + “Post messages” rights.
#    Or use a private chat: send /start to each bot first.
# 3. Get the chat ID:
#    • For channels/groups: forward any message to @userinfobot or @getidsbot – it replies with id like -1001234567890
#    • For private chat: send a message to @userinfobot
#    • Ensure it includes the minus sign for groups (-100...). Do NOT use @username.
# 4. Verify pin rights: if pin fails, check “Bots are offline” banner → chat check failed = fix permissions.
TELEGRAM_BOT_TOKENS=your_bot_token_here,your_second_bot_token_here
# For a single bot you can still use TELEGRAM_BOT_TOKEN instead.
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=-1001234567890  # e.g. -100… for channel, or 123456789 for private chat

# ── Access control ───────────────────────────────────────────────────────────
APP_USERNAME=admin
APP_PASSWORD=change-me-to-something-strong
# Random string used to sign session cookies (openssl rand -hex 32)
AUTH_SECRET=replace-with-a-long-random-string

# ── Optional ─────────────────────────────────────────────────────────────────
# Chunk size in MB sent per Telegram message (max 19, default 8; clamped to 4 on serverless).
TELEGRAM_CHUNK_MB=8
# Force the in-memory demo driver (no Telegram needed).
DEMO_MODE=false
