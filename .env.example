# ── Telegram storage ─────────────────────────────────────────────────────────
# 1. Create bots with @BotFather and copy the tokens.
# 2. Send /start to each bot, then read the chat id (e.g. via @userinfobot).
#    Every bot must be a member of TELEGRAM_CHAT_ID with send/pin rights.
#    Multiple tokens (comma-separated) make uploads/downloads run across bots
#    in parallel for higher throughput.
TELEGRAM_BOT_TOKENS=your_bot_token_here,your_second_bot_token_here
# For a single bot you can still use TELEGRAM_BOT_TOKEN instead.
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_private_chat_id_here

# ── Access control ───────────────────────────────────────────────────────────
APP_USERNAME=admin
APP_PASSWORD=change-me-to-something-strong
# Random string used to sign session cookies (openssl rand -hex 32)
AUTH_SECRET=replace-with-a-long-random-string

# ── Optional ─────────────────────────────────────────────────────────────────
# Chunk size in MB sent per Telegram message (max 19, default 8; clamped to 4 on serverless).
TELEGRAM_CHUNK_MB=8
# Force the in-memory demo driver (no Telegram needed).
DEMO_MODE=false
